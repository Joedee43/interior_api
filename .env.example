# Copy to .env (never commit .env). Real environment variables override it.

# development | test | production
APP_ENV=development
SERVER_PORT=5050

# Local PostgreSQL 18 on port 5433
DATABASE_URL=postgres://postgres:your_password@localhost:5433/interior_db?sslmode=disable

# Separate database used by integration tests and `migrate -test`.
# Tests that need it are skipped when it is unset.
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5433/interior_test?sslmode=disable

# Browser origins allowed to make POST/PATCH/DELETE requests (CSRF check),
# comma-separated. Default is the Next.js dev server.
# ALLOWED_ORIGINS=http://localhost:3000

# IP addresses/CIDRs of the Next.js server(s). Only these peers may supply
# X-Forwarded-For or X-Real-IP. Keep empty when Go is reached directly.
# TRUSTED_PROXIES=127.0.0.1,::1

# Optional separate-origin browser access. The normal Next.js rewrite does
# not need CORS; when enabled, exact ALLOWED_ORIGINS are allowed with cookies.
# ENABLE_CORS=false

# Login session lifetime (Go duration). Default 7 days.
# SESSION_TTL=168h

# Optional HTTP server timeouts (Go duration syntax). Defaults shown.
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=10s

# Where uploaded images and 3D models are stored (local disk). Default ./storage
# STORAGE_DIR=storage
